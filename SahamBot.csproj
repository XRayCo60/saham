<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SahamBot</RootNamespace>
    <AssemblyName>SahamBot</AssemblyName>
    <Version>2.0.0</Version>
    <Authors>SahamBot Team</Authors>
    <Description>Telegram Stock Market Simulation Bot</Description>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

</Project>
